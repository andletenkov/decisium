{
  "name": "decisium",
  "version": "0.1.0",
  "description": "Plain-English Gherkin steps run against a real browser by an AI agent, with record/replay cassettes",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "cucumber",
    "gherkin",
    "playwright",
    "e2e",
    "testing",
    "ai"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "decisium": "dist/cli.js"
  },
  "exports": {
    "./steps": {
      "types": "./dist/steps.d.ts",
      "default": "./dist/steps.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "default": "./dist/formatter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "docs/cookbook.md",
    "docs/configuration.md"
  ],
  "scripts": {
    "test": "node --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "example:server": "node examples/campaign-manager/server.ts",
    "cookbook": "node scripts/cookbook.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "pack:smoke": "scripts/pack-smoke.sh"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
