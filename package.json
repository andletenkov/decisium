{
  "name": "decisium",
  "version": "0.1.4",
  "description": "Semantic UI testing with decision models: plain-English Gherkin Steps executed by Jev in a real browser, pass/fail decided by code, record/replay cassettes",
  "type": "module",
  "license": "MIT",
  "author": "andletenkov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andletenkov/decisium.git"
  },
  "homepage": "https://andletenkov.github.io/decisium/",
  "bugs": {
    "url": "https://github.com/andletenkov/decisium/issues"
  },
  "keywords": [
    "cucumber",
    "gherkin",
    "playwright",
    "e2e",
    "testing",
    "decision-model",
    "jev",
    "semantic-testing"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "decisium": "dist/cli.js"
  },
  "exports": {
    "./steps": {
      "types": "./dist/steps.d.ts",
      "default": "./dist/steps.js"
    },
    "./formatter": {
      "types": "./dist/formatter.d.ts",
      "default": "./dist/formatter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "docs/configuration.md"
  ],
  "scripts": {
    "test": "node --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "example:server": "node test/fixtures/campaign-manager/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "site": "node scripts/site.ts",
    "version": "node scripts/site.ts && git add site",
    "pack:smoke": "scripts/pack-smoke.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 test/*.test.ts"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "marked": "^18.1.1",
    "typescript": "^7.0.2"
  }
}
