{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "mutate_comment": "Modules covered by test/*.unit.test.ts (no browser, sub-second); the browser/CLI suites take ~75s per run, too slow per mutant",
  "commandRunner": { "command": "node --test test/*.unit.test.ts" },
  "mutate": [
    "src/decision.ts",
    "src/observation.ts",
    "src/change.ts",
    "src/check.ts",
    "src/step.ts",
    "src/cassette.ts"
  ],
  "tsconfigFile_comment": "tsconfigFile points nowhere: TS 7 has no JS API for Stryker's tsconfig rewrite, and node runs src/ directly",
  "tsconfigFile": "stryker-skip-tsconfig.json",
  "ignorePatterns": ["dist", "site", "runs", "build", "reports", "features", "mise.local.toml", ".env"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 30000,
  "thresholds": { "high": 80, "low": 60, "break": 85 }
}
